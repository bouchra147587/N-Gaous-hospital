# Public: safe to expose to the browser, used for direct public-data fetches
# (departments, doctors, services, news, contact/appointment submission).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only: used by Next.js route handlers (app/api/auth/*, app/api/proxy/*)
# when they call FastAPI on behalf of the browser. Usually the same value as
# above in development; kept separate so it can point at an internal address
# in production without ever reaching client JS.
API_URL=http://localhost:8000
